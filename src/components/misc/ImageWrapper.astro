---
import { Image, Picture } from "astro:assets";
import path from "node:path";
import type { ImageMetadata } from "astro";
import type { ResponsiveImageLayout } from "../../utils/image-utils";
import {
	getFallbackFormat,
	getImageFormats,
	shouldAddNoReferrer,
} from "../../utils/image-utils";
import { getLqipProps } from "../../utils/lqip-utils";
import { url } from "../../utils/url-utils";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	type?: "image" | "video"; // 新增：支持视频类型
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	// 响应式图像属性
	layout?: ResponsiveImageLayout;
	usePicture?: boolean;
	formats?: ("avif" | "webp")[];
	width?: number;
	height?: number;
	widths?: number[];
	sizes?: string;
	quality?: number;
	fadeIn?: boolean;
	dataCoverImg?: boolean;
	showLqip?: boolean;
	showOverlay?: boolean;
}

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	type = "image",
	loading = "lazy",
	fetchpriority = "auto",
	layout,
	usePicture = false,
	formats,
	width,
	height,
	widths,
	sizes,
	quality,
	fadeIn = false,
	dataCoverImg = false,
	showLqip = false,
	showOverlay = true,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal && type === "image") {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass = fadeIn
	? "w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out"
	: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
const videoClass = "w-full h-full object-cover";
const videoStyle = `object-position: ${position}`;

// 检查是否需要添加 referrerpolicy（仅对非本地图片）
const fullSrc = isPublic ? url(src) : src;
const referrerPolicy =
	!isLocal && shouldAddNoReferrer(fullSrc) ? "no-referrer" : undefined;

// 构建响应式图像属性
const responsiveProps = {
	...(layout && { layout }),
	...(width && { width }),
	...(height && { height }),
	...(widths && { widths }),
	...(sizes && { sizes }),
	...(quality && { quality }),
};

// LQIP 渐变占位
const lqipProps = isLocal
	? getLqipProps(src, basePath)
	: isPublic
		? getLqipProps(src, basePath, true)
		: getLqipProps(src);
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    {fadeIn && showLqip && <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>}
    {showOverlay && <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>}
    {type === "image" && isLocal && img && usePicture && (
        <Picture src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} fetchpriority={fetchpriority}
                 data-cover-img={dataCoverImg ? true : undefined}
                 formats={formats || getImageFormats()} fallbackFormat={getFallbackFormat()} {...responsiveProps} />
    )}
    {type === "image" && isLocal && img && !usePicture && (
        <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} fetchpriority={fetchpriority}
               data-cover-img={dataCoverImg ? true : undefined} {...responsiveProps} />
    )}
    {type === "image" && !isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle}
                                          loading={loading} fetchpriority={fetchpriority} data-cover-img={dataCoverImg ? true : undefined} referrerpolicy={referrerPolicy} />}
    {type === "video" && <video
        src={isPublic ? url(src) : src}
        class={videoClass}
        style={videoStyle}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
    ></video>}
</div>
